{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seans",
  "version": "0.1.0",
  "identifier": "ru.tedeshi.seans",
  "mainBinaryName": "seans",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Seans",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "tedeshi",
    "copyright": "tedeshi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/mpv/*": "mpv/"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["seans"]
      }
    },
    "single-instance": null,
    "updater": {
      "endpoints": [
        "https://seans.tedeshi.ru/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMDRGMkFFRDEyQUQ4NDcKUldSSDJDclJydklFb0FKYkJ4bGdpUks2cXBsL01lZStaMm9GbVVPajhXWSsyMHpRUlN3Q2lyUWcK"
    }
  }
}
