{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Seans main window (M1 shell: deep-link + window focus; M11: updater check/download/install + process restart).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-set-title",
    "deep-link:default",
    "updater:default",
    "process:allow-restart",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://api.seans.tedeshi.ru/**" },
        { "url": "https://api.theintrodb.org/**" },
        { "url": "https://seans.tedeshi.ru/**" }
      ]
    }
  ]
}
